Object Bats "fladdermöss" R48
  with
    name "fladdermus" "fladdermöss" "mus" "möss",
    short_name_def "fladdermöss",
    plural "fladdermöss",
    describe "^I taket hänger några fladdermöss.",
    description "Det är en kompakt massa av grå kroppar, läderartade
                vingar och små gula ögon.",
    before [;
    ThrownAt:
      <<Attack self>>;
    Attack:
      remove self;
      move Hole to location;
      "Fladdermössen flyger skrämda iväg igenom ett hål i taket.";
    ],
  has animate;

Object Hole "hål"
  with
    name "hål" "hålet",
    short_name_def "hålet",
    description "Hålet är en naturlig spricka i berget, ett par meter bred.",
    describe [;
      print "^I taket finns ett hål";
      if(Rope has scenery) {
        print ". Ifrån hålet hänger ett rep som du kan klättra upp på";
      }
      ".";
    ],
    before [;
    ThrownAt:
      if(noun==Rope && Rope hasnt scenery) {
        R48.u_to=R49;
        move Rope to location;
        give Rope scenery;
        score=score+10;
        "Du har kastat upp repet.";
      }
    ],
  has static neuter;
  
