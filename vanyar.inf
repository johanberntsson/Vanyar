! ----------------------------------------------------------------------------
!   Things that happen every turn
! ----------------------------------------------------------------------------

[ TurnBefore;
    switch(action) {
    ##Swim:
        if(location == R29 or R33 or R34 or R36 or R37 or R38 or R39) {
            if(player hasnt general) {
                give player general;
                "Just as you are about to put your foot in the water you see
                strange bubbles in the middle of the stream. You wait a while,
                but nothing more shows itself.";
            }
            deadflag = 1;
            "You swim out into the river. The water suddenly turns cloudy around
            you and you hear a dull rumble. You feel a burning pain as an
            enormous green and slimy sea serpent tears off one of your hands, and
            then it throws itself upon you...";
        }
        if(location == Harbour or R6 or R21 or R23)
            "You swim out into the water, but soon return to land.";
    ##Wait:
        if(player.strength < 1000) player.strength = player.strength + 50;
    }
    rfalse;
];

[ TurnAfter;
    if(player has light) {
        give player ~light;
        print "^The match goes out.^";
    }

    if(location == Harbour && Diamond in player) {
        score = score + 5;
        deadflag = 2;
        print "^When you come back, your errand done, you are hailed and feasted
            by the crew of the ship";
        if(Angrist has animate)
            print ". King Angrist and his men shower you with treasure and good
                wishes";
        if(Teleri has animate)
            print ". Teleri takes his leave and says ~I go to the wizard. Take
                care of yourself~";
        print ".^";
        rtrue;
    }

    if(player.strength < 10) {
        print "^You died of exhaustion.^";
        deadflag = 1;
    } else if(player.strength < 80) {
        print "^You fall down from weariness.^";
        player.strength = player.strength + 200;
    } else if(player.strength < 180) {
        print "^You are so tired that you can hardly stand.^";
    } else if(player.strength < 250) {
        print "^You feel tired.^";
    }
];

! ----------------------------------------------------------------------------
!   Initialisation
! ----------------------------------------------------------------------------

[ Initialise;
    SetUpWindows();
    lookmode = 2; ! always show long descriptions (verbose)
    thedark.description = "It is pitch black, and you can't see a thing.";

    Banner();
    new_line;

    print "^It was in the year 2642 that king Telnor had word from his kinsman
        Angrist in the land of Vanyar beyond the seas. One of Angrist's vassals,
        Draupner, had risen in revolt and with the help of a dragon had invaded
        the northern part of Angrist's realm and stolen the Evenstar, the
        priceless diamond the dwarves found deep under the mountains at the
        beginning of time. Angrist asked for aid, and Telnor sent you, since you
        are held to be fearless and deadly. With you came also Teleri, a wise
        elf with great knowledge of powers that work but cannot be seen with the
        naked eye. After a long voyage the ship cast anchor off Angrist's
        castle.^^";

    StartDaemon(Elf);
    StartDaemon(Dwarf);
    StartDaemon(Guard);
    StartDaemon(Draupner);
    StartDaemon(Wizard);
    StartDaemon(Dragon);
    StartDaemon(Allvis);
    StartDaemon(Angrist);
    StartDaemon(Teleri);

    return 2; ! we have printed the banner ourselves
];


! ----------------------------------------------------------------------------
!   Menu driven help
! ----------------------------------------------------------------------------

[ HelpItems;
    print "There is information provided on the following:^^";
    print "     Introduction^";
    print "     How to play^";
    print "     Solution^";
];

[ HelpItemsAmusing;
    print "There is information provided on the following:^^";
    print "     Introduction^";
    print "     How to play^";
    print "     Solution^";
    print "     Amusing things^";
];

[ HelpSub;
    if(deadflag == 2) DoMenu(HelpItemsAmusing, HelpMenu, HelpInfo);
    else              DoMenu(HelpItems, HelpMenu, HelpInfo);
];

[ HelpMenu;
    switch(menu_item) {
    0: item_width = 13; item_name = "About this game";
       if(deadflag == 2) return 4; else return 3;
    1: item_width = 12; item_name = "Introduction";
    2: item_width = 11; item_name = "How to play";
    3: item_width = 8;  item_name = "Solution";
    4: item_width = 14; item_name = "Amusing things";
    }
];

[ HelpInfo;
    switch(menu_item) {
    1: print "Vanyar is the first large adventure game I wrote. It was designed
        by me and Mattias Geisler, and I did the programming. In 1986 the marvel
        was finished, in 800 lines of compact BASIC for the C64. The pictures
        were added at the beginning of 1987. In 2003 I played the game in an
        emulator, and suddenly felt the urge to convert it to a modern platform.
        In 2026 I decided to port this game once again to PunyInform and
        Ozmoo, using version 6 support for graphics. I, together with my good
        friend Fredrik Ramsberg, have written both software packages, and now
        this game will demonstrate how to add graphics to z6 games.^^\

        In this improved version I have tried to make small changes that remove
        the worst shortcomings of the original. There are no longer any mazes,
        and the map is laid out more logically. More things have descriptions,
        and a number of bugs have been fixed. There are still a few actions that
        kill you on the spot, but you get a warning first and you can always
        type ~undo~.^";

    2: print "In this game you control the main character by typing in commands
        that say what he is to do. Examples of such commands are:^^\

        > look^\
        > north (go north from where you are standing)^\
        > inventory (show a list of what you are carrying)^\
        > take the map^\
        > examine it (~it~ here refers to the map)^\
        > give the map to the woman^\
        > john, open the door (ask someone to do something)^\
        > ask john about the map^\
        > throw the knife at the black bird^^\

        There are a few common abbreviations:^^\
        g = again (repeat the last command)^\
        l = look^\
        i = inventory^\
        x = examine^\
        z = wait (lets the clock of the game tick on one step)^^\

        The possible directions are all the compass directions plus up and down.
        These can be abbreviated too: ~n~ means north, ~u~ means up, ~sw~ means
        south west and so on. ~exits~ lists the ways out of the room you are in.^^\

        A game can be saved with ~save~ and a saved game can later be fetched
        with ~restore~. You can start the game over with ~restart~ and end it
        with ~quit~. ~score~ shows how many points you have. When you score
        points the game says so, but that can be turned off with ~notify off~.^^\

        If you make a mistake you can take the game back one step with ~undo~. If
        you misspell a word you can use ~oops~ instead of typing the whole
        command again.^^\
        > take the mip^\
        You can't see any such thing.^\
        > oops map^\
        Taken.^^\

        You can change how much the game tells you about a place you have been to
        before with the commands ~short~, which always shows the short listing,
        ~long~, which always shows the long description, and ~normal~, which puts
        the game back to its usual behaviour.^";

    3: print "This is the solution. The fights are random, so some changes may be
        needed when you play. Teleri wanders off on his own, so if he is not on
        the balustrade with you, wait until he turns up before telling him to
        read the parchment.^^\
        n, w, s, take ham, w, take box, ne, e, n, w, n, take branch, s, sw, u,
        burn branch, take axe, extinguish branch, down, w, ne, ne, ne, e, w, sw,
        sw, sw, e, ne, e, e, e, e, n, chop tree with axe, chop tree with axe, e,
        s, take rope, n, n, n, e, burn branch, e, kill bats, throw rope at hole,
        up, e, up, up, take parchment, down, down, s, e, take herb, w, n, n, w,
        w, nw, sw, s, sw, eat bread, eat bread, eat bread, ne, n, ne, say
        algeothel, s, s, up, up, push sideboard, w, take broadsword, e, up, sw,
        ~teleri, read parchment~, kill dragon, kill dragon, e, kill draupner,
        kill draupner, take diamond, w, ne, down, down, s, s, s, s, s, w^";

    4: print "Amusing things to try^^\
        * Swim in the river.^\
        * Climb the mountain.^\
        ";
    }
];
