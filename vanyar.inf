! ----------------------------------------------------------------------------
!   Weapons
! ----------------------------------------------------------------------------

! The wandering monsters draw a weapon from here when they turn up, and hand
! it back when they leave.
Object Weapons
    with
        get_weapon [_i _x _y;
            ! return a random child of self
            _x = random(children(self));
            if(_x == 0) rfalse;
            _y = child(self);
            for(_i = 1 : _i < _x : _i++) _y = sibling(_y);
            return _y;
        ],
    ;

Object Sling "sling" Weapons
    with
        name 'sling',
        damage 8,
        description "Handy if Goliath turns up.",
    ;

Object Club "club" Weapons
    with
        name 'club',
        damage 5,
        description "Heavy, and easy to grip.",
    ;

