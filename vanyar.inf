Object -> -> Matches "matches"
    with
        name 'match' 'matches',
        counter 6,
        description [;
            print_ret "There are ", (number) self.counter, " matches left.";
        ],
        before [;
        Burn:
            if(location hasnt light) {
                print "In the feeble light of the match you look around you.^";
                give player light;
                UseMatch();
                PlayerTo(real_location);
                rtrue;
            }
            "Say what you want to set fire to instead.";
        ],
    has pluralname;

