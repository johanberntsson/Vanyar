    introduction "~Det ska bli skönt att få gå på fast mark igen~, säger Teleri 
                 och går nedför landgången",
    loc1 R1 R2 R3 R4 R5 R6 R7 R8 R9 R10 R11 R12 R13 R14 R15 R16 R17 R18 R19 R20
         R21 R22 R23 R24 R25 R26 R27 R28 R29 R30 R31 R32,
    loc2 R40 R41 R42 R43 R44 R56 R57 R58 R59 R60 R61 R62 R63 R64 R65 R66,
    skill 16,
    strength 350,
    orders [;
    Give: return self.order_give();
    Drop: return self.order_drop();
    Take: return self.order_take();
    Go: return self.order_go();
    Attack: print_ret (The) self, " säger ~Jag dödar inte på befallning~.";
    Examine:
      if(noun==Scroll) {
        print "Teleri läser ~hakuee ptr'uio nasc!~";
        if(Dragon in location && DragonFlame in Dragon) {
          remove DragonFlame;
          move DragonTail to Dragon;
          print ". Draken rycker till och elden slocknar";
        }
        ".";
      }
    ],
  has proper;
  
PersonBase VanyarPlayer
  with
    number 0,
    skill 20,
    strength 500,
    description "Muskler, OK. Vapen, OK. Mod, OK. Var är draken?",
    each_turn [;
      if(self has light) {
        give self ~light;
        "^Tändstickan slocknar.";
      }
      if(location==R2 && Diamond in player) {
        score=score+5;
        deadflag=2;
        print "^När du kommer tillbaka efter att ha slutfört ditt
              uppdrag hyllas och firas du av besättningen på fartyget";
        if(Angrist has animate) {
          print ". Kung Angrist och hans män överöser dig med skatter och lyckönskningar";
        }
        if(Teleri has animate) {
          print ". Teleri tar farväl och säger ~Jag går till trollkarlen. Ta vara på dig~";
        }
        print_ret ".";
      }
!      self.strength=self.strength-4;
      if(self.strength<10) {
        print"^Du dog av utmattning.^";
        deadflag=1;
      } else  if(self.strength<80) {
        print"^Du faller omkull av trötthet.^";
        self.strength=self.strength+200;
      } else if(self.strength<180) {
        print"^Du är så trött att du knappt kan stå.^";
      } else if(self.strength<250) {
        print"^Du känner dig trött.^";
      }
    ],
    before [;
    Attack: deadflag=1; "Du begår självmord";
    ],
    react_before [;
    Answer:
      if(location==R42) {
        wn = consult_from;
        if(R42.s_to==0 && NextWord()=='algeothel') {
          R42.s_to=R56;
          "En dörr öppnas i klippväggen. Du kan gå syd.";
        }
      }
    Swim:
      if(location==R29 or R33 or R34 or R36 or R37 or R38 or R39) {
        if(self hasnt general) {
          give self general;
          "Just som du ska sätta foten i vattnet ser du mystiska bubblor mitt
          i vattnet. Du väntar ett tag, men inget mer syns.";
        }
        deadflag=1;
        "Du simmar ut i floden. Vattnet blir plötsligt grumligt runt
        omkring dig och du hör ett dovt muller. Du känner en brinnande smärta när
        en enorm grön och slemmig sjöorm sliter av dig ena handen, och sedan
        kastar den sig över dig...";
      }
      if(location==R2 or R6 or R21 or R23) "Du simmar ut i vattnet, men återvänder snart till land.";
    Wait:
      if(player.strength<1000) self.strength=self.strength+50;
    ],
  ;

Object Dagger "dolk" R5
  with
    name "dolk" "dolken",
    short_name_def "dolken",
    damage 3,
  ;

Object Sword "svärd" Angrist
  with
    name "svärd" "svärdet",
    short_name_def "svärdet",
    damage 9,
  has neuter;
  
Object Diamond "diamant" Draupner
  with
    name "diamant" "diamanten",
    short_name_def "diamanten",
    after [;
    Take:
      if(self hasnt general) {
        give self general;
        score=score+10;
      }
    ],
  ;  

[ Initialise;
  #ifdef TARGET_ZCODE;
  @erase_window -1;
  #ifnot;
  glk_window_clear(gg_mainwin);
  #endif;
  
  print "^";
#ifdef TARGET_GLULX;
  ShowGraphics(true, true);
#endif;

  lookmode=2; ! Always show long descs (verbose)
  thedark.description=Darkness_description;
  
    print "Det var år 2642 som kung Telnor fick bud från sin frände Angrist i landet Vanyar
          bortom haven. En av Angrists vasaller, Draupner, hade gjort uppror och med hjälp
          av en drake invaderat den norra delen av Angrists rike och stulit Aftonstjärnan;
          den oskattbara diamanten som dvärgarna hittade djupt under bergen i tidernas
          begynnelse. Angrist bad om bistånd och Telnor skickade dig eftersom du är ansedd
          som orädd och dådkraftig. Med dig kom även Teleri, en vis alv med stora
          kunskaper om krafter som verkar men inte kan ses med blotta ögat. Efter en lång resa kastade
          skeppet ankar utanför Angrists slott.^^";
    ChangePlayer(VanyarPlayer);
    location=R1;
    StartDaemon(Elf);
    StartDaemon(Drawf);
    StartDaemon(Guard);
    StartDaemon(Draupner);
    StartDaemon(Wizard);
    StartDaemon(Dragon);
    StartDaemon(Allvis);
    StartDaemon(Angrist);
    StartDaemon(Teleri);
  }
];

! ----------------------------------------------------------------------------
!   Menu-driven help
! ----------------------------------------------------------------------------

[ HelpSub;
#ifdef TARGET_GLULX;
  ShowGraphics(false);
#endif;

  if(deadflag==2) {
    DoMenu("Det finns information om följande:^\
            ^     Introduktion\
            ^     Hur man spelar\
            ^     Lösning\
            ^     Roliga saker^",
            HelpMenu, HelpInfo);
  } else {
    DoMenu("Det finns information om följande:^\
            ^     Introduktion\
            ^     Hur man spelar\
            ^     Lösning^",
            HelpMenu, HelpInfo);
  }
  
#ifdef TARGET_GLULX;
  ShowGraphics(true);
#endif;
];

[ HelpMenu;
  switch(menu_item) {
  0: item_width=6;item_name="Om detta spel";
     if(deadflag==2) return 4; else return 3;
  1: item_width=6;item_name="Introduktion";
  2: item_width=7; item_name="Hur man spelar";
  3: item_width=4; item_name="Lösning";
  4: item_width=6;item_name="Roliga saker";
  }
];

[ HelpInfo;
  switch(menu_item) {
  1: print "Vanyar är det första större äventyrsspelet som jag skrev. Designen gjordes av mig och
           Mattias Geisler, och programmeringen stod jag för. 1986 var underverket klart, i 800
           rader kompakt Basic-kod för C64. Bilderna tillkom i början av 1987. År 2003 spelade jag
           spelet i en emulator, och fick plötsligt lust att konvertera det till en modern
           plattform. Eftersom min gode vän Fredrik Ramsberg just fått sitt försvenskningspaket
           till Inform färdigt så fanns inga praktiska hinder, utan jag skrev ut en listning
           och satte igång. Nu sitter du med resultatet, och jag hoppas att du gillar spelet.^^\
           
           I den förbättrade versionen har jag försökt göra små
           ändringar som tar bort de värsta bristerna i orignalversionen. Nu finns inte längre
           några labyrinter och kartan är mer logiskt uppbyggd. Fler saker har beskrivningar,
           och ett antal buggar har åtgärdats. Det finns fortfarande några handlingar som
           dödar dig på fläcken, men du får varningar innan och du kan alltid skriva ~ångra~.^^\
           
           Spelet är ett åttiotalsspel på gott och ont, och jag skulle inte skriva spelet på samma
           sätt idag. Om du tycker att spelet är alltför svårt kanske du borde titta på något av
           mina övriga äventyrspel. Du kan välja mellan Drakmagi, The Temple och Vacation Gone Awry.
           Samtliga spel finns på Interactive Fiction archive (http://ifarchive.org/if-archive).
           Skicka gärna emot brev med kommentarer och/eller felrapporter till
           johan@@64microheaven.com.^";
  2: print "Du bör ha en interpretator som kan hantera svenska tecken. Besök
      http://swedish.ramsberg.net om du behöver hjälp med detta. För att kunna skriva
      svenska tecken i en interpretator som inte klarar det, eller med ett tangentbord
      som inte har dessa tecken, skriv ~transkription~ i spelet. Därefter kan du
      skriva å som aa, ä som ae och ö som oe. Skriv ~transkription av~ för att stänga
      av transkriptionsfunktionen igen.^^\

     I detta spel kontrollerar du huvudrollsinnehavaren genom att skriva in kommandon
     som talar om vad denne ska göra. Exempel på dessa kommandon är:^^\

     > se (se dig omkring)^\
     > norr (gå norr från där du står just nu)^\
     > lista (visa en lista på de föremål du bär på)^\
     > ta kartan^\
     > undersök den (~den~ syftar här på kartan (*))^\
     > ge kartan till kvinnan^\
     > Kalle, öppna dörren (be någon göra något)^\
     > fråga Kalle om kartan (fråga om något)^\
     > kasta kniven på den svarta fågeln^^\

     (*) Vilket föremål ~den~ syftar på ändras dels när du refererar till ett föremål,
     men även när du kommer till en ny plats eller listar de föremål du bär på. Förutom
     ~den~ finns det även ~det~, ~honom~, ~henne~ och ~dem~. Du kan när som helst under
     spelets gång skriva ~pronomen~ för att få reda på vad de refererar till.^^\

     Det finns några vanliga förkortningar:^^\
     g = igen (repetera det senaste kommandot)^\
     t = titta^\
     l = lista^\
     x = undersök^\
     z = vänta (får spelets klocka att ticka vidare ett steg)^^\
     De möjliga riktningarna är alla kompassriktningar plus upp och ned. Dessa kan också förkortas:
     ~n~ betyder norr, ~u~ betyder upp, ~sv~ betyder sydväst osv.^^\

     Ett spel kan sparas med ~spara~ och ett sparat spel kan senare hämtas med ~hämta~. Du kan börja om
     spelet med ~börja om~ och sluta spelet med ~avsluta~.
     ~poäng~ visar hur många poäng du har fått och ~full poäng~ ger mer information
     om vilka delmoment av spelet du klarat av. När du får poäng talar spelet om detta, men utskriften
     går att kontrollera med ~meddelanden på~ och ~meddelanden av~^^\

     Om du gör ett misstag kan du backa spelet ett steg med ~ångra~. Om du stavar ett ord fel kan du
     använda ~oj~ för att slippa skriva om hela kommandot en gång till.^^\
     > ta kortan^\
     Någon sådan ser du inte till.^\
     > oj koftan^\
     Tagen.^^\

     Den första gången du kommer till en plats visas en lång beskrivning men nästa gång du kommer dit
     får du bara namnet på platsen samt en kort lista med de viktigaste föremålen. Du kan ändra på detta
     med kommandona
     ~kort~ som alltid visar den korta listan, ~lång~  som alltid visar den långa beskrivningen och
     ~normal~ återställer spelet till det normala beteendet som beskrevs innan.
     Andra kommandon är ~saker~ som visar vilka sakerna du manipulerat, ~platser~
     som visar en lista med platser du besökt samt ~utskrift på~ respektive ~utskrift av~ som
     påbörjar och avslutar lagring av all speltext på en fil.^";
  3: print "Detta är lösningen till orginalversionen av Vanyar. Striderna är slumpmässiga, så vissa
           modifieringar kan behövas när du spelar.^^\
           n, v, n, ta skinkan, v, ta asken, sö, ö, nö, v, nv, ta gren, s, sv, u, tänd gren,
           ta yxa, släck gren, ned, v, nö, nö, nö, ö, v, sv, sv, s, sö, nö, sö, nö, ö, ö, nv,
           ö, hugg träd med yxa, hugg träd med yxa, ö, s, ta repet, n, n, n, ö, tänd gren,
           sö, sö, döda fladdermöss, kasta repet på hålet, u, ö, u, u, ta pergamentet, ned, ned,
           s, ö, ta örten, v, n, n, n, v, nv, sv, s, sv, ät bröd, ät bröd, ät bröd, ö, n, nö,
           säg algeothel, s, s, u, u, flytta skänken, v, ta slagsvärdet, ö, u, sv,
           ~teleri, läs pergamentet~, döda draken, döda draken, döda draken, ö, döda draupner,
           döda draupner, ta diamanten, v, nö, ned, ned, s, s, ö, sv, sv, nv, s, sö, s^^\
           Detta är lösningen till den förbättrade versionen av Vanyar.^^\
           n, v, s, ta skinkan, v, ta asken, nö, ö, n, v, n, ta gren, s, sv, u, tänd gren,
           ta yxa, släck gren, ned, v, nö, nö, nö, ö, v, sv, sv, sv, ö, nö, ö, ö, ö, ö, n,
           hugg träd med yxa, hugg träd med yxa, ö, s, ta repet, n, n, n, ö, tänd gren,
           ö, döda fladdermöss, kasta repet på hålet, u, ö, u, u, ta pergamentet, ned, ned,
           s, ö, ta örten, v, n, n, v, v, nv, sv, s, sv, ät bröd, ät bröd, ät bröd, nö, n,
           nö, säg algeothel, s, s, u, u, flytta skänken, v, ta slagsvärdet, ö, u, sv,
           ~teleri, läs pergamentet~, döda draken, döda draken, ö, döda draupner,
           döda draupner, ta diamanten, v, nö, ned, ned, s, s, s, s, s, v^";
           
  4: print "Kul saker att testa^^\
           * Simma i floden.^\
           * Klättra uppför berget.^\
           ";
  }
];

