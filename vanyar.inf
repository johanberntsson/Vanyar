Object Hole "hole"
    with
        name 'hole' 'crack',
        description "The hole is a natural crack in the rock, a couple of yards
            wide.",
        describe [;
            print "^There is a hole in the ceiling";
            if(Rope has scenery)
                print ". A rope hangs from the hole, and you could climb up it";
            print ".^";
            rtrue;
        ],
        before [;
        ThrownAt:
            if(noun == Rope && Rope hasnt scenery) {
                R48.u_to = R49;
                move Rope to location;
                give Rope scenery;
                score = score + 10;
                "You have thrown the rope up.";
            }
        ],
    has static;

