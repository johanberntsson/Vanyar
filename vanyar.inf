!% -~S
!% $OMIT_UNUSED_ROUTINES=1
!% $ZCODE_LESS_DICT_DATA=1
!% $LONG_DICT_FLAG_BUG=0
!% $ZCODE_COMPACT_GLOBALS=1
!
! Vanyar
!
! (c) 1986, 2003, 2026 Johan Berntsson, johan@microheaven.com
!
! You may use this code for reference and copy parts of the code
! into your own game, but please don't make new versions of *this*
! game without my permission.
!
! HISTORY:
!
! 1986:   Written in 800 lines of compact BASIC for the Commodore 64.
!         Design by Johan Berntsson and Mattias Geisler, code by
!         Johan Berntsson. The pictures were added in early 1987.
! 030513: First lines of the Inform version written, all descriptions
!         and graphics from the C64 version inserted.
! 030526: All code ported.
! 030527: Begun coding the new version (Vanyar 2003). Major improvements:
!         a logical and simplified map, more and better descriptions of
!         rooms and objects, no maze, the end scene moved to the harbour,
!         no sudden death, and only the broad sword will damage the dragon.
! 030603: Vanyar 2003 finished.
!
! 260831: Translated to English and ported from the Inform 6 standard
!         library (with the Swedish language pack) to PunyInform. The
!         text follows the 2003 Swedish version closely rather than
!         expanding on it.

Constant Story    "Vanyar";
Constant Headline "^(c) 2026 Johan Berntsson.
    Type ~help~ for instructions.^";

Constant STATUSLINE_SCORE; Statusline score;

Constant OPTIONAL_FULL_DIRECTIONS;
Constant OPTIONAL_EXTENDED_METAVERBS;
Constant OPTIONAL_EXTENDED_VERBSET;
Constant OPTIONAL_PROVIDE_UNDO;
Constant DEATH_MENTION_UNDO;

Constant MAX_SCORE = 100;
Constant AMUSING_PROVIDED;

Constant INITIAL_LOCATION_VALUE = Ship;
Constant CUSTOM_PLAYER_OBJECT   = VanyarPlayer;

Include "globals.h";

! A second general purpose flag, used for "you have been warned once"
! situations and to mark the wandering monsters that are conjured up
! rather than being real characters.
Attribute generic;

! Common properties used all over the game.
Property desc;      ! The room description proper; Room.description adds exits
Property damage;    ! How much harm a weapon does in a fight
Property strength;  ! Hit points, for the player and for every creature
Property skill;     ! How good a fighter someone is
Property picture;   ! A room's picture number - the same as its room number
Property pic_dir;   ! Which way the picture is looking; PIC_N .. PIC_W below

! Properties which only a handful of objects have, so they are kept out of
! the (limited) set of common properties.
Property individual add_score;
Property individual counter;
Property individual nutrition;
Property individual portions;
Property individual leftover;
Property individual finish_message;
Property individual consume_message;
Property individual move_probability;
Property individual leave_probability;
Property individual wait_probability;
Property individual attack_probability;
Property individual kill_score;
Property individual armour_score;
Property individual introduced;
Property individual introduction;
Property individual live_description;
Property individual dead_description;
Property individual enter_message;
Property individual wait_message;
Property individual loc1;
Property individual loc2;
Property individual describe_carried;
Property individual kill_me;
Property individual attack;
Property individual order_go;
Property individual order_give;
Property individual order_drop;
Property individual order_take;
Property individual get_weapon;

[ PrintRank;
    print ", and you have ", (number) player.strength, " strength points.
        That makes you ";
    if (score >= 95) "a hero.";
    if (score >= 80) "a warrior.";
    if (score >= 60) "a seasoned adventurer.";
    if (score >= 30) "an amateur.";
    "a beginner.";
];


! ----------------------------------------------------------------------------
!   The z6 screen
!
!   row 1                    window 1, the ordinary PunyInform status line
!   rows 2 .. 1+picwin_rows  window 2, the picture and its caption
!   the rest                 window 0, the game, scrolling and buffered with
!                            [MORE] prompts, exactly as usual
!
!   This is the layout of the 2003 Glulx version (see
!   screenshots/vanyar-screenshot.png), rebuilt on the z6 window model with
!   PunyInform's ext_z6graphics.h. The z5 build compiles all of this out.
! ----------------------------------------------------------------------------

! The value of pic_dir. These are indexes into direction_name_array, so the
! caption can print the direction without a switch of its own.
Constant PIC_N = 1;
Constant PIC_S = 2;
Constant PIC_E = 3;
Constant PIC_W = 4;

#Iftrue (#version_number == 6);

Constant PICWIN            = 2;  ! the z6 window number of the picture window
Constant PICWIN_ROWS_GUESS = 10; ! height to use if we can't measure a picture
Constant MIN_TEXT_ROWS     = 6;  ! never leave the game less than this

Global picwin_top;               ! first screen row of the picture window
Global picwin_rows;              ! its height in rows, caption included
Global picwin_cols;              ! its width in columns (the whole screen)
Global shown_picture;            ! the picture currently in the window

Include "ext_z6graphics.h";

[ SetUpWindows _rows;
    _rows = HDR_SCREENHLINES->0;
    if(_rows < 10) _rows = 25;               ! a sane guess if the header lies
    picwin_cols = HDR_SCREENWCHARS->0;
    if(picwin_cols < 10) picwin_cols = 40;

    ! Every one of the 66 pictures is a 224x72 PETSCII screen, so measuring one
    ! of them fixes the layout for the whole game and the text window never
    ! moves. Add one row for the caption under the picture.
    if(Z6PictureExists(1)) picwin_rows = Z6PictureRows_Chars(1) + 1;
    if(picwin_rows < 2) picwin_rows = PICWIN_ROWS_GUESS;
    if(_rows - 1 - picwin_rows < MIN_TEXT_ROWS)
        picwin_rows = _rows - 1 - MIN_TEXT_ROWS;
    if(picwin_rows < 1) picwin_rows = 1;
    picwin_top = 2;                          ! just under the status line

    ! Window 1, the status line. PunyInform makes this itself with
    ! @split_window the first time it draws the status line, but in v6
    ! split_window also resets window 0 to "everything below window 1", which
    ! would undo the layout. So do the split here, once, and tell the library
    ! the height it already has: _StatusLineHeight() then never splits again.
    ! (The count is in units in v6, hence the font height; PunyInform does the
    ! same multiplication.)
    @split_window Z6RowToY(statusline_height);
    statusline_current_height = statusline_height;

    ! Window 2, the picture window: no wrapping, no scrolling, no buffering.
    ! Nothing in here should ever scroll or raise a [MORE].
    Z6FormatWindow(PICWIN, 0, Z6_WSTYLE_SET);
    Z6ShowWindow_Chars(PICWIN, 1, picwin_top, picwin_cols, picwin_rows);

    ! Window 0, the game. Move it below the picture window and shrink it to the
    ! rest of the screen; it keeps its default attributes (wrapping, scrolling,
    ! transcripting and buffering, z-spec 8.8.3.3), so word wrap and the [MORE]
    ! prompt work in it exactly as in any other game.
    Z6ShowWindow_Chars(0, 1, picwin_top + picwin_rows,
        picwin_cols, _rows - picwin_top - picwin_rows + 1);
    Z6SetWindow(0);
];

! Put a picture in the picture window, centred, with the caption the 1986
! version printed under it. Call it with 0 to leave the window empty, which is
! what darkness looks like.
[ ShowPicture p_picture p_dir _w _h _x _y _xu _yu _len;
    shown_picture = p_picture;
    Z6SetWindow(PICWIN);
    Z6EraseWindow(PICWIN);
    if(p_picture && Z6PictureExists(p_picture)) {
        _w = Z6PictureCols_Chars(p_picture);
        _h = Z6PictureRows_Chars(p_picture);
        _x = 1 + (picwin_cols - _w) / 2;
        _y = 1 + (picwin_rows - 1 - _h) / 2;
        if(_x < 1) _x = 1;
        if(_y < 1) _y = 1;
        Z6MoveCursor_Chars(1,1);
        Z6DrawPictureHere(67);
        !Z6MoveCursor_Chars(_x, _y);
        _xu = Z6ColToX(_x);
        _yu = Z6RowToY(_y);
        Z6MoveCursor_Units(_xu, 11);
        Z6DrawPictureHere(p_picture);

!       if(p_dir) {
            ! "This is what you see looking " is 29 characters, and the full
            ! stop makes 30; north and south are five letters, east and west
            ! four. Work the width out rather than measuring, so that the
            ! caption can be centred before it is printed.
!           _len = 30;
!           if(p_dir == PIC_N or PIC_S) _len = _len + 5; else _len = _len + 4;
!           _x = 1 + (picwin_cols - _len) / 2;
!           if(_x < 1) _x = 1;
!           Z6MoveCursor_Chars(_x, picwin_rows);
!           print "This is what you see looking ",
!               (string) direction_name_array-->p_dir, ".";
!       }
    }
    ! Back to the game window. This also flushes anything still buffered.
    Z6SetWindow(0);
];

! Called at the end of every room description, darkness included, so this is
! the one place that has to keep the picture window in step with the game.
[ LookRoutine;
    if(location == thedark) { ShowPicture(0, 0); rtrue; }
    if(location provides picture) ShowPicture(location.picture, location.pic_dir);
    else ShowPicture(0, 0);
];

#Ifnot; ! not z6 - the text-only build has nothing to set up and nothing to draw

[ SetUpWindows; ];

#Endif;

! PunyInform tests for these entry point routines with #Ifdef while it is being
! included, so they have to exist by then. The real work is done further down,
! where the actions and the objects they talk about are known.
[ GamePreRoutine; return TurnBefore(); ];
[ TimePasses; TurnAfter(); ];
[ Amusing; HelpSub(); ];

Include "ext_cheap_scenery.h";
Include "ext_menu.h";

Include "puny.h";

! ----------------------------------------------------------------------------
!   New grammar
! ----------------------------------------------------------------------------

Verb meta 'help' 'h//'
    *                                           -> Help;

Verb 'row'
    *                                           -> Row
    * noun                                      -> Row;

Verb 'extinguish' 'douse' 'quench'
    * noun                                      -> Extinguish;

Verb meta 'exits' 'directions'
    *                                           -> Exits;

Extend 'eat' first
    * noun                                      -> Eat;

! "say algeothel" with no listener named
Extend 'answer' last
    * topic                                     -> Answer;

Extend 'climb' last
    * 'in' noun                                 -> Climb;

Extend 'tie' replace
    * noun                                      -> Tie
    * noun 'to'/'on'/'onto' noun                -> ThrowAt;

[ RowSub;
    if(player in Boat) <<Row Boat>>;
    if(noun == 0) "I take it you mean ~row something~, but what?";
    print_ret "You can't row ", (the) noun, ".";
];

[ ExtinguishSub;
    "You can't put out something that isn't burning.";
];

! ----------------------------------------------------------------------------
!   Support routines
! ----------------------------------------------------------------------------

! List the exits from a room. Only strings are left out - a string in a
! direction property is a refusal, not a way out.
[ ListExits p_room p_msg _i _prop _v _n _c;
    for(_i = 1 : _i <= DIRECTION_COUNT : _i++) {
        _prop = direction_properties_array->_i;
        @get_prop p_room _prop -> _v;
        if(_v ~= 0 && (_v ofclass String) == false) _n++;
    }
    if(_n == 0) rfalse;
    print (string) p_msg;
    for(_i = 1 : _i <= DIRECTION_COUNT : _i++) {
        _prop = direction_properties_array->_i;
        @get_prop p_room _prop -> _v;
        if(_v ~= 0 && (_v ofclass String) == false) {
            _c++;
            print (string) direction_name_array-->_i;
            if(_c == _n - 1) print " and ";
            else if(_c < _n) print ", ";
        }
    }
    print ".^";
    rtrue;
];

[ ExitsSub;
    if(ListExits(real_location, "You can go ") == false)
        "There is nowhere to go from here.";
];


! ----------------------------------------------------------------------------
!   Classes
! ----------------------------------------------------------------------------

Class Room
    with
        add_score 0,
        description [;
            print (string) self.desc, "^";
            ListExits(self, "You can go ");
            if(self.add_score > 0) {
                score = score + self.add_score;
                self.add_score = 0;
            }
        ],
        u_to "You left your wings at home.",
        d_to "You should have brought a spade.",
    has light;

Class Food
    with
        nutrition 10,
        portions 1,
        before [;
        Eat, Drink:
            if(player.strength > 1000) "You are full already.";
            player.strength = player.strength + self.nutrition;
            self.portions = self.portions - 1;
            if(self.portions == 0) {
                if(self provides leftover)
                    move self.leftover to parent(self);
                remove self;
                if(self provides finish_message)
                    print_ret (string) self.finish_message;
                print_ret "Now ", (the) self, " is all gone.";
            }
            if(self provides consume_message)
                print_ret (string) self.consume_message;
            print_ret "You eat some of ", (the) self, ".";
        ],
    has edible;

Class PersonBase
    with
        strength 0,
        skill 0,
    has animate;

Class Person class PersonBase
    with
        move_probability 0,
        leave_probability 0,
        wait_probability 0,
        attack_probability 0,
        kill_score 0,
        armour_score 0,
        introduced 0,
        loc1 0,
        loc2 0,

        describe_carried [;
            if(PrintContents(1, self) == 0) rfalse;
            print " ", (The) self, " is carrying ";
            PrintContents(0, self);
            print ".";
        ],

        describe [;
            if(self has animate) {
                if(self.introduced == 0 && self provides introduction)
                    print "^", (string) self.introduction, ".";
                else
                    print "^", (The) self, " is here.";
                self.describe_carried();
                self.introduced = 1;
            } else {
                print "^", (The) self, " lies dead in front of you.";
            }
            print "^";
            rtrue;
        ],

        description [;
            if(self has animate) {
                if(self provides live_description)
                    print (string) self.live_description, ".";
                else
                    print "You see nothing special about ", (the) self, ".";
                self.describe_carried();
            } else {
                if(self provides dead_description)
                    print (string) self.dead_description, ".";
                else
                    print (The) self, " lies dead in front of you.";
            }
            print "^";
            rtrue;
        ],

        daemon [_i _p;
            if(self notin location) {
                _p = 0;
                for(_i = 0 : _i < self.#loc1 / 2 && _p == 0 : _i++)
                    if(self.&loc1-->_i == location) _p = location;
                for(_i = 0 : _i < self.#loc2 / 2 && _p == 0 : _i++)
                    if(self.&loc2-->_i == location) _p = location;

                if(_p ~= 0 && random(100) < self.move_probability) {
                    move self to location;
                    if(self has generic) {
                        self.skill = 18;
                        self.strength = 400;
                        if(child(self) == 0) {
                            _i = Weapons.get_weapon();
                            if(_i) move _i to self;
                        }
                        print "^Here comes ", (a) self, ".";
                    } else {
                        print "^", (string) self.enter_message;
                    }
                    self.describe_carried();
                    "";
                }
            } else {
                if(random(100) < self.attack_probability) {
                    print "^", (The) self, " attacks!^^";
                    self.attack();
                }
                if(random(100) < self.leave_probability) {
                    remove self;
                    print "^", (The) self, " leaves.^";
                    if(child(self)) move child(self) to Weapons;
                } else {
                    if(random(100) < self.wait_probability) {
                        if(self provides wait_message)
                            print "^", (string) self.wait_message, "^";
                        else
                            print "^", (The) self, " waits.^";
                    }
                }
            }
        ],

        kill_me [;
            if(self has animate) {
                give self ~animate;
                give self static;
                StopDaemon(self);
                while(child(self)) move child(self) to parent(self);
                if(self.kill_score > 0) score = score + self.kill_score;
            }
        ],

        attack [p_weapon _my_weapon _player_damage _my_damage _ka _kd _x _o;
            ! Pick a weapon for the player, unless one was supplied
            _player_damage = 1;
            if(p_weapon == 0) {
                p_weapon = Fist;
                objectloop(_o in player)
                    if(_o provides damage && _o.damage > _player_damage) {
                        p_weapon = _o;
                        _player_damage = p_weapon.damage;
                    }
            } else if(p_weapon provides damage) {
                _player_damage = p_weapon.damage;
            }

            ! Pick a weapon for the attacker
            _my_weapon = Fist;
            _my_damage = 1;
            objectloop(_o in self)
                if(_o provides damage && _o.damage > _my_damage) {
                    _my_weapon = _o;
                    _my_damage = _my_weapon.damage;
                }

            ! Hit points: own skill + weapon damage + luck
            _ka = _my_damage + self.skill + random(12);
            _kd = _player_damage + player.skill + random(12);
            ! Damage points
            _x = 10 * random(36);

            if(self.armour_score > _player_damage) {
                print (The) p_weapon, " makes no impression on ",
                    (the) self, "'s armour.^^";
                _kd = 0;
            }

            if(_kd < _ka) {
                print (The) self, " wounds you with ", (the) _my_weapon, ".^";
                player.strength = player.strength - _x;
            }
            if(_ka < _kd) {
                print "You wound ", (the) self, " with ", (the) p_weapon, ".^";
                self.strength = self.strength - _x;
            }
            if(_ka == _kd) print "A miss...^";

            if(player.strength < 0) {
                deadflag = 1;
                "^The blow kills you.";
            }
            if(self.strength < 0) {
                if(self has generic) {
                    remove self;
                    print_ret "^The body of ", (the) self, " dissolves.";
                }
                self.kill_me();
                print_ret "^", (The) self, " dies.";
            }
            if(self.strength < 150)
                print "^", (The) self, " looks very tired.^";
        ],

        before [;
        Attack:
            if(self hasnt animate) print_ret (The) self, " is dead already.";
            self.attack(second);
            rtrue;
        ],

        life [;
        Ask, Tell, Answer:
            "In this game you can only talk to your companions by giving them
            orders, such as ~teleri, give me the sword~.";
        ],

        order_go [_prop _dest;
            if(random(2) == 1) print_ret (The) self, " shakes his head.";
            _prop = selected_direction;
            if(_prop == 0) rfalse;
            @get_prop location _prop -> _dest;
            if(_dest ~= 0 && UnsignedCompare(_dest, top_object) <= 0 &&
                    _dest ofclass Room) {
                move self to _dest;
                print_ret (The) self, " goes ",
                    (string) direction_name_array-->selected_direction_index, ".";
            }
            rfalse;
        ],

        order_give [;
            if(noun in self) {
                if(second ~= player)
                    print_ret (The) self, " won't give anything to ", (the) second, ".";
                move noun to player;
                print_ret (The) self, " gives you ", (the) noun, ".";
            }
            print_ret (The) self, " hasn't got ", (the) noun, ".";
        ],

        order_drop [;
            if(noun in self) {
                move noun to location;
                print_ret (The) self, " drops ", (the) noun, ".";
            }
            print_ret (The) self, " hasn't got ", (the) noun, ".";
        ],

        order_take [;
            if(noun in location) {
                if(noun has animate || noun has static || noun has concealed ||
                        noun has scenery)
                    print_ret (The) self, " can't take ", (the) noun, ".";
                move noun to self;
                print_ret (The) self, " takes ", (the) noun, ".";
            }
            print_ret (The) self, " can't see ", (the) noun, ".";
        ],
    ;

! Strike one of the matches. The six matches of the original are kept as a
! single object with a count, so that the parser never has to ask which of six
! identical matches the player means.
[ UseMatch;
    Matches.counter = Matches.counter - 1;
    if(Matches.counter == 0) remove Matches;
];

! ----------------------------------------------------------------------------
!   Rooms and the things that stand in them
! ----------------------------------------------------------------------------

[ ParseNameShip _w _n;
    _w = NextWord();
    while(_w == 'grey' or 'gray') { _n++; _w = NextWord(); }
    if(_w == 'boat' or 'ship') return _n + 1;
    return _n;
];  

[ ParseNameIvoryCastle _w _n;
    _w = NextWord();
    while(_w == 'ivory' or 'snow-white' or 'snow' or 'white') { _n++; _w = NextWord(); }
    if(_w == 'castle') return _n + 1;
    return _n;
];  

Room Ship "Ship"
    with
        picture 1,
        pic_dir PIC_W,
        desc
            "You are aboard a grey ship. To the west you can see the towers of an
            ivory castle. You can go down onto the quay by the gangway to
            the north.",
        cheap_scenery
        CS_NO_ADJ 'quay'
            "A quiet stone wharf. Your vessel is the only ship docked here."
        CS_NO_ADJ 'gangway'
            "A narrow wooden ramp leading north down to the quay."
        CS_PARSE_NAME ParseNameShip
            "A sturdy wooden vessel. She will wait here until your return."
        CS_PARSE_NAME ParseNameIvoryCastle
            "Its snow-white towers gleam under the sun, some distance away.",
        n_to Harbour,
        cant_go "That way leads down into the water. The only way from here is
            the gangway leading to the harbour, which lies to the north.",
    ;

Person -> Teleri "Teleri"
    with
        name 'teleri',
        move_probability 90,
        wait_probability 30,
        enter_message "Teleri comes in.",
        wait_message "Teleri says ~Let us hurry~.",
        live_description "Teleri is a good companion to have with you on a
            dangerous errand",
        dead_description
            "Teleri's open eyes still mirror his surprise at the unexpected
            attack",
        introduction "~It will be good to walk on firm ground again~, says Teleri,
            and walks down the gangway",
        loc1 Ship Harbour Yard KnightsHall R5 R6 R7 R8 R9 R10 R11 R12 R13 R14 R15 R16 R17 R18 R19
            R20 R21 R22 R23 R24 R25 R26 R27 R28 R29 R30 R31 R32,
        loc2 R40 R41 R42 R43 R44 R56 R57 R58 R59 R60 R61 R62 R63 R64 R65 R66,
        skill 16,
        strength 350,
        orders [;
        Give: return self.order_give();
        Drop: return self.order_drop();
        Take: return self.order_take();
        Go: return self.order_go();
        Attack: print_ret (The) self, " says ~I do not kill to order~.";
        Examine:
            if(noun == Scroll) {
                print "Teleri reads ~hakuee ptr'uio nasc!~";
                if(Dragon in location && DragonFlame in Dragon) {
                    remove DragonFlame;
                    move DragonTail to Dragon;
                    print ". The dragon starts back and its fire goes out";
                }
                ".";
            }
        ],
    has proper;

Room Harbour "Harbour"
    with
        picture 2,
        pic_dir PIC_N,
        desc
            "You are in a large harbour. It looks abandoned. A clear path leads
            west.",
        cheap_scenery
        'large' 'harbour'
            "Rows of empty stone berths stretch out along the quiet bay. The only ship here is yours."
        'clear' 'path'
            "A road worn smooth by years of wagon traffic, winding west.",
        n_to R8,
        s_to Ship,
        e_to R6,
        w_to Yard,
    ;

Room Yard "Castle Yard"
    with
        picture 3,
        pic_dir PIC_S,
        add_score 5,
        desc
            "You are standing in the yard of the ivory castle. Through an
            open door to the south you can see a large, well lit hall.",
        cheap_scenery
        CS_NO_ADJ 'yard'
            "The ground is silent and deserted."
        'open' 'door'
            "A heavy oak door frame stands wide open to the south, leading into the main hall."
        'large' 'hall'
            "You can see a bright, well-lit hall just through the open doorway to the south.",
        s_to KnightsHall,
        e_to [;
            if(Angrist in location && Angrist hasnt general) {
                give Angrist general;
                print "^You take your leave of Angrist. He says ~Let me give you
                    one piece of advice: seek the help of the wizard in the west.
                    Farewell, and good luck~.^^";
            }
            return Harbour;
        ],
        sw_to R5,
        cant_go "A wall bars your way.",
    ;

Person -> Angrist "Angrist"
    with
        name 'angrist',
        move_probability 80,
        wait_probability 20,
        enter_message "Angrist, the white king, comes in.",
        live_description "Angrist looks old and tired",
        dead_description "The body of Angrist is covered with blood",
        introduction
            "King Angrist has aged before his time and is sunk in dark thoughts,
            but he checks himself when he catches sight of you and says in
            surprise ~So my message to king Telnor got through at last~. He tells
            you of Draupner's revolt and how he kept his dragon secret until he
            lured the king's troops into an ambush, where most of the men fit to
            bear arms were burnt to death. It is only a matter of time before
            Draupner gathers his forces to take the southern part of the country
            as well. Angrist says that he means to die in his castle, but that
            most of his people have fled to the mountains",
        loc1 Yard KnightsHall R5,
        skill 15,
        strength 350,
        orders [;
        !Give: return self.order_give();
        !Go: return self.order_go();
        !Drop: return self.order_drop();
        !Take: return self.order_take();
        Attack: print_ret (The) self, " says ~I do not kill to order~.";
        default: 
            "King Angrist barely seems to hear you. His mind is heavy with the ruin of his kingdom.";
        ],
    has proper transparent;

Object -> -> Sword "sword"
    with
