Object Mountain "berg"
  with
    name "berg" "berget",
    short_name_def "berget",
    found_in R10 R16 R36 R37 R38 R39,
    before [;
    Climb:
      if(self hasnt general) {
        give self general;
        "Du börjar klättra uppför berget men råkar ta i en lös sten och faller ned
        igen. Inget är brutet, och det verkar finnas en bättre väg ett par meter
        vid sidan av, ifall du vill försöka igen.";
      }
      deadflag=1;
      "Du börjar klättra uppför berget. När du har kommit 15-20 meter upp
      tappar du plötsligt tappar fästet. Dessvärre faller du så illa att
      du bryter nacken.";
    ],
  has neuter scenery;
  
Room R11 "Pass"
  with
    picture Pic11,
    pic_dir w_obj,
    desc
      "Du är i ett trångt pass som slingrar sig mellan de höga bergssidorna.
       Ovanför dig öppnar sig en spricka i klippväggen.",
    w_to R12,
    ne_to R9,
    u_to R14,
    cant_go "En klippvägg hindrar din framfart.",
;

Room R12 "Kulle"
  with
    picture Pic12,
    pic_dir n_obj,
    desc
      "Du står på en låg kulle nedanför passet och blickar ut över en stor skog som
       breder ut sig i nordöstlig riktning. Skogen erbjuder en enastående syn med
       kronor som glimmar likt guld.,en nästan vördnadsfull känsla av ålder
       och mystik sveper över dig. Du flyttar blicken åt väster och skådar ut över
       en ofruktsam öken.",
    n_to R13,
    e_to R11,
    w_to R17,
