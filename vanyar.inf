        counter 0,
        description "The sideboard is a heavy piece of furniture of black oak.",
        before [;
        Push, Pull:
            if(self has general) {
                give self ~general;
                R61.w_to = 0;
                "You push the sideboard back.";
            }
            give self general;
            R61.w_to = R63;
