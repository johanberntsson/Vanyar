Object -> Tree "tree"
    with
        name 'tree' 'trunk',
        counter 0,
        description [;
            if(self.counter == 2) "The rotten tree lies like a bridge across the
                river.";
            "The rotten tree stands by the river bank.";
        ],
        before [;
        Climb:
            if(self.counter < 2) "The tree is far too rotten.";
        Cut:
            "You will need something to cut it with.";
        Attack:
            if(second ~= Axe) print_ret (The) second, " makes no impression on
                the tree.";
            if(self.counter == 0) {
                self.counter = 1;
                "The tree groans at your blow.";
            }
            if(self.counter == 1) {
                self.counter = 2;
                score = score + 10;
                R34.e_to = R38;
                "The rotten tree falls heavily, and lies like a bridge across the
                river.";
            }
            "You have already felled the tree.";
        ],
    has scenery;

Room R35 "Before the Castle"
