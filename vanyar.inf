            if(self hasnt general) {
                give self general;
                "You start climbing the mountain but happen to grab a loose stone
                and fall back down. Nothing is broken, and there seems to be a
                better way up a couple of yards to the side, if you want to try
                again.";
            }
            deadflag = 1;
            "You start climbing the mountain. When you have got fifty feet up you
            suddenly lose your grip. Unhappily you fall so badly that you break
            your neck.";
        ],
    has scenery;

