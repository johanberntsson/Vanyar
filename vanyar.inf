Object Branch "gren" R10
  with
    name "gren" "grenen" "fackla" "facklan",
    short_name_def "grenen",
    description [;
      if(self has light) "Grenen brinner och är en utmärkt fackla.";
      "Grenen är kådrik.";
    ],
    number 0,
    daemon [;
      if(self has light) {
        self.number=self.number+1;
        if(self.number==150) { ! was 50
          StopDaemon(self);
          if(TestScope(self)) print "^Grenen har brunnit upp.^";
          remove self;
        }
      }
    ],
    before [;
    Extinguish:
      if(self hasnt light) "Grenen brinner ju inte.";
      give self ~light;
      StopDaemon(self);
      "Du släcker grenen.";
    Burn:
      if(second==0) {
        if(TestScope(Matchbox)==false || child(Matchbox)==0) "Du har inga tändstickor.";
        second=child(Matchbox);
      }
      if(second ofclass Match) {
        if(self provides light) "Grenen brinner redan.";
        remove second;
        give self light;
        StartDaemon(self);
        "Du tänder på grenen med en tändsticka.";
      } else {
        "Du måste tända med en tändsticka.";
      }
    ],
  ;
  
