    cant_go "Den enda vägen ut är tillbaka till riddarsalen.",
;

Room R63 "Vapenkammare"
  with
    picture Pic63,
    pic_dir e_obj,
    desc
      "Genom den låga gången har du kommit in i en vapenkammare. Du ser
      allehanda rustningar och vapen. De flesta är dock trasiga eller
      sönderrostade. Några lysande undantag finns dock. Din blick
      fångas bl.a. av några slagsvärd av god kvalitet som verkar orörda
      av tidens tand.",
   e_to R61,
   cant_go "Den enda vägen ut är tillbaka till riddarsalen.",
;

Room R64 "Trappa"
  with
    picture Pic64,
    pic_dir s_obj,
    desc
      "Du är högst uppe på trappan. Det finns en port i sydväst och genom
      denna ser du en svart svans av enorma mått sticka fram.",
    sw_to R65,
    d_to R61,
    cant_go "Ditt val är att retirera nedför trappan, eller att modigt kliva ut
            på balustraden genom porten i sydväst.",
;

Room R65 "Balustrad"
  with
    picture Pic65,
    pic_dir e_obj,
    desc
      "Du har kommit ut i fria luften igen och befinner dig nu på slottets 
      balustrad. Avlagringar av sot täcker väggar och golv. Här uppifrån
      kan man se ut över en tät skog. Du ser en trappnedgång i nordöst och
      en stor port i öst.",
    e_to R66,
    ne_to R64,
    cant_go "En kort blick nedåt får dig att avstå.",
;

Room R66 "Tronsal"
  with
    picture Pic66,
    pic_dir n_obj,
    desc
