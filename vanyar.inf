!
! Vanyar 2003. The updated version of Vanyar
! Major improvements:
! * Logical and simplified map
! * More and better descriptions of rooms and objects
! * No maze!
! * End scene moved to harbour
! * no sudden death
! * Only the broad sword will damage the dragon
!
! HISTORY:
! 030513: First lines of code written, all descriptions and graphics
!         from the C64 version inserted.
! 030526: All code ported.
! 030527: Begun coding the new version (Vanyar 2003)
! 030603: Vanyar2003 finished.
!
! BUGS: It's not a bug, it's a feature!
! 030602: window not correct size after leaving "help". Update bug in wglulxe?

Include "SweAlpha";

Constant Story "Vanyar";
Constant Headline "^(c) 2003, 1986 Johan Berntsson. Skriv ~hjälp~ eller ~h~ för instruktioner.^";
Constant MAX_SCORE 100;
!Constant SACK_OBJECT backpack;
Constant AMUSING_PROVIDED;
[ Amusing; HelpSub(); ];

Attribute generic;

Replace PrintRank;
Replace TellSub;
Replace AskSub;

Include "Parser";

!
! Support routines for Glulx graphics
!
#ifdef TARGET_GLULX;
Include "Infglk";

Include ">vanyar.bli";

Global imageok;
Global gg_picwin;
Global gg_dirwin;
Global curr_pic = 0;
Global curr_dir = 0;

Constant GG_PICWIN_ROCK 210;
Constant GG_DIRWIN_ROCK 211;

[ HandleGlkEvent ev;
  switch(ev-->0) {
  evtype_Redraw:
	glk_window_clear(gg_picwin);
	glk_window_clear(gg_dirwin);
	if(curr_pic>0) DrawPic(curr_pic, curr_dir);
  evtype_Arrange:
	glk_window_clear(gg_picwin);
	glk_window_clear(gg_dirwin);
	if(curr_pic>0) DrawPic(curr_pic, curr_dir);
  }
];

[ IdentifyGlkObject phase type ref rock;
  if(phase==0) { ! Zero out references to our objects.
	gg_picwin = 0;
	gg_dirwin = 0;
	return;
  }

  if(phase==1) { ! Reset our windows, streams and filerefs.
    switch (type) {
    0: ! it's a window
      switch (rock) {
      GG_PICWIN_ROCK: gg_picwin=ref;
      GG_DIRWIN_ROCK: gg_dirwin=ref;
      }
    1: ! it's a stream
    2: ! it's a fileref
    }
    return;
  }

  if (phase == 2) {
	if(curr_pic>0) DrawPic(curr_pic, curr_dir);
  }
];
   
[ DrawPic pic dir  w h pw ph dw dh ww;  
  if(imageok) {
    glk_window_get_size(gg_picwin, gg_arguments, gg_arguments+4);
    w=gg_arguments-->0;
    h=gg_arguments-->1;
    pw=224;
    ph=72;
    dw=pw/10;
    dh=ph/10;
    
    if(w<=pw || h<=ph) {
      ! picture bigger than window, scale down
      while(w<=pw || h<=ph) {
        ! make smaller until the picture fits into the window
        pw=pw-dw;
        ph=ph-dh;
      }
    } else {
      ! picture smaller than window, scale up
      while((pw+dw)<w && (ph+dh)<h) {
        ! make bigger until the picture fits into the window
        pw=pw+dw;
        ph=ph+dh;
      }
    }
    dw=(w-pw)/2;
    dh=(h-ph)/2;
    glk_image_draw_scaled(gg_picwin, pic, dw, dh, pw, ph);
    
    glk_set_window(gg_dirwin);
    glk_window_get_size(gg_dirwin, gg_arguments, gg_arguments+4);
    w=gg_arguments-->0;
    if(dir==n_obj or w_obj) ww=(w-32)/2;
    else if(dir==s_obj or e_obj) ww=(w-31)/2;
    else ww=(w-30)/2;
    if(ww<0) ww=0;
    glk_window_move_cursor(gg_dirwin, ww, 0);    
    print "Detta ser du i ";
    switch(dir) {
      n_obj: print "nordlig";
      s_obj: print "sydlig";
      e_obj: print "östlig";
      w_obj: print "västlig";
      default: print "någon";
    }
    print " riktning.";
    curr_pic=pic;
    curr_dir=dir;
    glk_set_window(gg_mainwin);
  }
];

[ ShowGraphics mode warn; ! show if mode==true, otherwise hide
  if(glk_gestalt(gestalt_Graphics, 0)==0) {
     imageok=false;
     if(warn) {
       print "[Tyvärr kan inte din interpretator hantera grafik, så inga bilder kan visas]^^";
     }
     rfalse;
  }
  
  if(mode) {
    if(imageok==true) rfalse;  
    imageok=true;
    if(gg_picwin==0) gg_picwin=glk_window_open(gg_mainwin, (winmethod_Above+winmethod_Proportional), 40, wintype_Graphics, GG_PICWIN_ROCK);
	if(gg_dirwin==0) gg_dirwin=glk_window_open(gg_mainwin, (winmethod_Above+winmethod_Fixed), 1, wintype_TextGrid, GG_DIRWIN_ROCK);
    if(curr_pic>0) DrawPic(curr_pic, curr_dir);
  } else {
    if(imageok==false) rfalse;  
    imageok=false;
    glk_window_close(gg_picwin);
    glk_window_close(gg_dirwin);
    gg_picwin=0;
    gg_dirwin=0;
  }
];
#endif;

#ifndef TARGET_GLULX;
! need to add dummies to be able to compile in z-code mode
Include ">vanyar.bli";
#endif;

Include "VerbLib";
Include "SweRout";
Include "SwedishG";

#IFDEF DEBUG;
  Message "DEBUG mode DEBUG mode DEBUG mode DEBUG mode DEBUG mode DEBUG mode !";
#ENDIF;

! -------- New grammar -------------------

Verb 'hjälp' 'h//' * -> Help;

Verb 'ro'
  * -> Row
  * noun -> Row;
[ RowSub;
  if(player in Boat) <<Row Boat>>;
  if(noun==0) "Jag antar att du menar ~ro något~, men vad?";
  print_ret "Du kan inte ro ", (the) noun, "."; 
];

Verb 'hugg'
  * noun 'med' held -> CutWith;
[ CutWithSub;
  print_ret "En sådan pryl kan jag inte hugga."; 
];

Extend 'döda' last
  * noun 'med' held -> Attack;

Extend 'klättra' last
  * 'i' noun        -> Climb
  * noun            -> Climb;
  
Extend 'ät' first
  * noun -> Eat;

Verb meta 'utgångar' 'riktningar'
  * -> Exits;
    
Verb 'släck'
  * held -> Extinguish;
[ ExtinguishSub;
  print_ret "Du kan inte släcka något som inte brinner."; 
];

[ AskSub; TellSub(); ];

[ TellSub;
  "I detta spel kan du bara kommunicera med dina medspelare med order,
  som t.ex. ~Angrist, ge mig svärdet~.";
];

[ ExitsSub msg i x y n;
  if(msg==0) msg="Du kan gå ";

  n=0;
  objectloop(x in Compass) {
    y=x.door_dir;
    if(location.y && metaclass(location.y)~=String) n=n+1;
  }
      
  if(n>0) {
    print (string) msg;
    i=0;
    objectloop(x in Compass) {
      y=x.door_dir;
      if(location.y && metaclass(location.y)~=String) {
        LanguageDirection(y);
        i=i+1;
        if(i==n-1) print " och ";
        else if(i<n) print ", ";
      }
    }
    print ".^";
  }
];

! -------- Routines -------------------

[ PressAnyKey msg pkey;
  if(msg) print (string) msg;
#ifdef TARGET_ZCODE;
  @read_char 1 0 0 pkey;
#ifnot;
  pkey=KeyCharPrimitive();
#endif;
  return pkey;
];

[ PrintRank;
  print ", och du har ", (number) player.strength, " styrkepoäng. Det gör dig till ";
  if (score>=95) "en hjälte.";
  if (score>=80) "en krigare.";
  if (score>=60) "ett halvproffs.";
  if (score>=30) "en amatör.";
  "en nybörjare.";
];

[ Darkness_description;
#ifdef TARGET_GLULX;
!  print "Ritar mork bild^";
  glk_window_clear(gg_picwin);
  glk_window_clear(gg_dirwin);
#endif;
  "Det är kolsvart, och du kan inte se någonting alls.";
];


! ------------ Classes -------------------

Class Room
  with
    add_score 0,
    description [;    
#ifdef TARGET_GLULX;
      if(self provides picture) DrawPic(self.picture, self.pic_dir);
#endif;

      print (string) self.desc, "^";
      
      ExitsSub("^Du kan gå ");
      
      if(self.add_score>0) {
        score=score+self.add_score;
        self.add_score=0;
      }
    ],
    u_to "Du lämnade dina vingar hemma.",
    d_to "Du borde ha tagit med en spade.",    
  has light;

Class Food
  with
    nutrition 10,
    portions 1,
    before [;
    Eat, Drink:
      if(player.strength>1000) "Du är redan mätt.";
      player.strength=player.strength+self.nutrition;
      
      self.portions=self.portions-1;
      if(self.portions==0) {
        if(self provides leftover) {
          move self.leftover to parent(self);
        }
        remove self;
        if(self provides finish_message) {
          print_ret (string) self.finish_message;
        } else {
          print_ret "Nu är ", (the) self, " slut.";
        }
      } else {
        if(self provides consume_message) {
          print_ret (string) self.consume_message;
        } else {
          print_ret "Du äter av ", (the) self, ".";
        }
      }
    ],
  has edible;
  
class PersonBase
  with
    strength 0,
    skill 0,
  has animate;

Class Person class PersonBase
  with
    move_probability 0,
    leave_probability 0,
    wait_probability 0,
    attack_probability 0,
    kill_score 0,
    armour_score 0,
    introduced 0,
    
    describe_carried [x n;
      n=0;
      objectloop(x in self) {
        if(x hasnt concealed) n=n+1;
      }
      if(n>0) {
        print " ",(The) self, " bär ";
        WriteListFrom(child(self), CONCEAL_BIT+ENGLISH_BIT);
        print ".";
      }
    ],
    
    describe [;
      if(self has animate) {
        if(self.introduced==0 && self provides introduction) {
          print "^", (string) self.introduction, ".";
        } else {
          print "^", (The) self, " är här.";
        }
        self.describe_carried();
        self.introduced=1;
      } else {
        print "^", (The) self, " ligger död framför dig.";
      }
      "";
    ],
    description [;
      if(self has animate) {
        if(self provides live_description) {
          print (string) self.live_description, ".";
        } else {
          print "Du ser inget speciellt med ", (the) self, ".";
        }
        self.describe_carried();
      } else {
        if(self provides dead_description) {
          print (string) self.dead_description;
        } else {
          print (The) self, " ligger död framför dig.";
        }
      }
      "";
    ],
    daemon [i p;
      if(self notin location) {
        p=0;
        for(i=0: i<self.#loc1/2 && p==0: i++) {
          if(self.&loc1-->i==location) {
            p=location;
          }
        }
        for(i=0: i<self.#loc2/2 && p==0: i++) {
          if(self.&loc2-->i==location) {
            p=location;
          }
        }
        
        if(p~=0 && random(100)<self.move_probability) {
          move self to location;
          if(self has generic) {
            self.skill=18;
            self.strength=400;
            if(child(self)==0) {
              i=Weapons.get_weapon();
              if(i) {
                move i to self;
              }
            }            
            print "^En ", (name) self, " kommer.";
          } else {
            print "^", (string) self.enter_message;
          }
          self.describe_carried();
          "";
        }
      } else {
        if(random(100)<self.attack_probability) {
          print "^", (The) self, " anfaller!^^";
          self.attack();
        }
        if(random(100)<self.leave_probability) {
          remove self;
          print "^", (The) self, " går ut.^";
          if(child(self)) move child(self) to Weapons;
        } else {
          if(random(100)<self.wait_probability) {
            if(self provides wait_message) {
              print "^", (string) self.wait_message, "^";
            } else {
              print "^", (The) self, " väntar.^";
            }
          }
        }
      }
    ],
    
    kill_me [;
      if(self has animate) {
        give self ~animate;
        give self static;
        StopDaemon(self);
        while(child(self)) {
          move child(self) to parent(self);
        }
        if(self.kill_score>0) {
          score=score+self.kill_score;
        }
      }
    ],
    attack [player_weapon my_weapon player_damage my_damage ka kd x;
      ! Select a weapon for the player, unless already supplied
      player_damage=1;
      if(player_weapon==0) {
        player_weapon=Fist;

        objectloop(x in player) {
          if(x provides damage && x.damage>player_damage) {
            player_weapon=x;
            player_damage=player_weapon.damage;
          }
        }
!        print "(med ", (the) player_weapon, ")^";
      } else if(player_weapon provides damage) {
        player_damage=player_weapon.damage;
      }

      ! select a weapon for the actor
      my_weapon=Fist;
      my_damage=1;
      objectloop(x in self) {
        if(x provides damage && x.damage>my_damage) {
          my_weapon=x;
          my_damage=my_weapon.damage;
        }
      }
      

      ! calculate hit points (own skill+weapon damage+random)
      ka=my_damage+self.skill+random(12);
      kd=player_damage+player.skill+random(12);
      ! Damage points
      x=10*random(36);

      if(self.armour_score>player_damage) {
        print (The) player_weapon, " biter inte på ", (name) self, "s pansar.^^";
        kd=0;
      }
      
      if(kd<ka) {
        print (The) self, " skadar dig med ", (the) my_weapon, ".^";
        player.strength=player.strength-x;
      }
      if(ka<kd) {
        print "Du skadar ", (the) self, " med ", (the) player_weapon, ".^";
        self.strength=self.strength-x;
      }
      if(ka==kd) print "Miss...^";
      if(player.strength<0) {
        deadflag=1;
        "^Slaget dödar dig.";
      }
      if(self.strength<0) {
        if(self has generic) {
          remove self;
          print_ret "^", (The) self, "s kropp löses upp.";
        } else {
          self.kill_me();
          print_ret "^", (The) self, " dör.";
        }
      }
      if(self.strength<150) {
        print "^", (The) self, " verkar mycket trött.^";
      }
    ],
    before [;
    Attack:
      if(self hasnt animate) print_ret (The) self, " är redan död.";
      self.attack(second);
      rtrue;
    ],    
    order_go [x y;
      if(random(2)==1) print_ret (The) self, " skakar på huvudet.";
      switch(noun) {
      n_obj: x=location.n_to; y="norr";
      s_obj: x=location.s_to; y="söder";
      e_obj: x=location.e_to; y="öster";
      w_obj: x=location.w_to; y="väster";
      ne_obj: x=location.ne_to; y="nordöst";
      nw_obj: x=location.nw_to; y="nordväst";
      se_obj: x=location.se_to; y="sydöst";
      sw_obj: x=location.sw_to; y="sydväst";
      };
      if(x ofclass Room) {
        move self to x;
        print_ret (The) self, " går ", (string) y, ".";
      }
      rfalse;
    ],
    order_give [;
      if(noun in self) {
        if(second~=Player) {
          print_ret (The) self, " vill inte ge något till ", (the) second, ".";
        }
        move noun to player;
        print_ret (The) self, " ger dig ", (the) noun, ".";
      } else {
        print_ret (The) self, " har inte ", (the) noun, ".";
      }
      rfalse;
    ],
    order_drop [;
      if(noun in self) {
        move noun to location;
        print_ret (The) self, " släpper ", (the) noun, ".";
      } else {
        print_ret (The) self, " har inte ", (the) noun, ".";
      }
      rfalse;
    ],
    order_take [;
      if(noun in location) {
        if(noun has animate || noun has static || noun has concealed || noun has scenery) {
          print_ret (The) self, " kan inte ta ", (the) noun, ".";        
        }
        move noun to self;
        print_ret (The) self, " tar ", (the) noun, ".";
      } else {
        print_ret (The) self, " ser inte ", (the) noun, ".";
      }
      rfalse;
    ],
  ;

Class Match 
  with
    name "tändsticka" "tändstickan" "sticka" "stickan",
    short_name_indef "tändsticka",
    short_name_def "tändstickan",
    plural "tändstickor",
    before [;
    Burn:
      if(location hasnt light) {
        print "I det svaga skenet ifrån tändstickan ser du dig omkring.^";
        give player light;
        remove self;
        PlayerTo(real_location);
        rtrue;
      }
      "Skriv vad du vill tända eld på istället.";
    ]
  ;
  
! ------------ Rooms -------------------
Room R1 "Fartyg"
  with
    picture Pic01,
    pic_dir w_obj,
    desc 
      "Du är ombord på ett grått fartyg. Västerut ser du tornen av ett snövitt slott.
      Du kan gå ner på kajen via landgången i norr.",
    n_to R2,
    cant_go "Den vägen leder ned i vattnet. Den enda vägen härifrån är
            landgången som leder till hamnen, som ligger norrut.",
  ;

Room  R2 "Hamn"
  with
    picture Pic02,
    pic_dir n_obj,
    desc
      "Du är i en stor hamn. Den ser övergiven ut. En tydlig stig går åt väst.",
    n_to R8,
    s_to R1,
    e_to R6,
    w_to R3,
  ;
  
Room R3 "Borggård"
  with
    picture Pic03,
    pic_dir s_obj,
    add_score 5,
    desc
      "Du står på borgården i det snövita slottet. Genom en öppen dörr i söder
      kan du se ett stort och väl upplyst rum.",
    s_to R4,
    e_to [;
      if(Angrist in location && Angrist hasnt general) {
        give Angrist general;
        print "^Du tar farväl av Angrist. Han säger ~Låt mig ge dig ett råd,
              sök hjälp av trollkarlen i väst. Farväl och lycka till~.^";
      }
      return R2;
    ],
    sw_to R5,
    cant_go "En vägg hindrar dig.",
;

