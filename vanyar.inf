Object Weapons
  with
    get_weapon [i x y;
      ! return random child of self
      x=random(children(self));
      if(x==0) rfalse;
      y=child(self);
      for(i=1: i<x: i++) {
        y=sibling(y);
      }
      return y;
    ],
  ;
  
