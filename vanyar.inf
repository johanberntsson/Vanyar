Object -> Boat "boat"
    with
        name 'boat',
        description "The boat is small and badly worn.",
        before [;
        Row:
            if(self hasnt generic) {
                give self generic;
                "Just as you are about to cast off you see something move in the
                water.";
            }
            deadflag = 1;
            "You cast off and row out into the river. The water suddenly turns
            cloudy around you and you hear a dull rumble. You feel a burning pain
            as an enormous green and slimy sea serpent tears off one of your
            hands, and then it throws itself upon you...";
        Push, Pull:
            player.strength = player.strength - 80;
            "Aargh, that took some doing.";
        ],
    has scenery enterable container open;

Room R34 "River Bank"
