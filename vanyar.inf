Room R20 "Labb"
  with
    picture Pic20,
    pic_dir e_obj,
    add_score 10,
    desc
      "Du är i ett rum som används som labb. I låsta skåp längs väggarna ser du
      mängder av flaskor. Mitt i rummet är ett stenbord uthugget ur klippan.
      Du ser två stängda dörrar. Åt nordöst ser du en dörröppning och genom
      den en ravin.",
    each_turn [;
      if(Wizard hasnt animate) rfalse;
      if(Wizard hasnt general) {
        give Wizard general;
        "^En röst dånar mot dig. ~Jag är Sirion, trollkarlen.
        Hämta dvärgen Allvis mäktiga ört och jag ska hjälpa dig.
        Teleri, en av mina lärjungar, ger dig bistånd.";
      } else if(Herb in player) {
        remove Herb;
        score=score+10;
        "^En mäktig stämma säger ~Tack, min vän~. Örten löses upp i rök.
        ~Om du säger 'algeothel sayed' någonstans i ravinen öppnas en 
        lönngång. Du kan gå genom östporten~. Rösten ekar bort i salen.";
      }
    ],
    w_to R19,
    ne_to MagicDoor,
    cant_go "Det finns mycket sten i den riktningen.",
;

Object MagicDoor "magisk port"
  with
    name "port" "magisk" "dörröppning" "porten" "dörröppningen",
    short_name_def "magiska porten",
    door_to [;
      if(location==R20) return R44;
      return R20;
    ],
    door_dir [;
      if(location==R20) return ne_to;
      return sw_to;
    ],
    before [;
    Enter:
      if(self hasnt open) "Du kan inte passera en magisk port så.";
    Open:
      if(self hasnt open) "Dörrarna är magiska och släpper inte 
                          igenom andra än mästare i magi.";
    ],
    found_in R20 R44,
  has scenery door;
  
