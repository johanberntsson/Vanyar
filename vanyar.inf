            "The banner shows a stylised black dragon."
        'open' 'gate'
            "The gate stands open. Through it you can see a courtyard."
        'wall' 'walls'
            "The wall runs around the castle."
        21 'large' 'abandoned' 'courtyard'
            "The courtyard looks abandoned.",
        n_to [;
            if(Dragon has animate) "The dragon would kill you at once.";
            return R58;
        ],
        s_to R27,
