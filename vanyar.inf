      "Det murkna trädet står vid flodstranden.";
    ],
    before [;
    Climb: if(self.number<2) "Trädet är alltför murket.";
    CutWith:
      if(second~=Axe) print_ret (The) second, " biter inte på trädet.";
      if(self.number==0) {
        self.number=1;
        "Trädet gnäller vid ditt hugg.";
      }
      if(self.number==1) {
        self.number=2;
        score=score+10;
        R34.e_to=R38;
        "Det murkna trädet faller tungt, och ligger som en bro över floden.";
      }
      "Du har ju redan fällt trädet.";
    ],
  has neuter scenery;
  
