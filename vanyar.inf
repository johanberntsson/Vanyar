Object Bench "skänk" R61
  with
    name "skänk" "skänken",
    short_name_def "skänken",
    number 0,
    description
      "Skänken är en tung möbel av svart ek.",
    before [;
    Push:
      if(self has general) {
        give self ~general;
        R61.w_to=0;
        "Du skjuter tillbaka skänken.";        
      } else {
        give self general;
        R61.w_to=R63;
        if(self.number==0) {
          self.number=1;
	      score=score+15;
	    }
        "Vid väggen där skänken stod ser du ett lågt hål som du kan gå igenom.";
      }
    ],
  has scenery supporter;
  
