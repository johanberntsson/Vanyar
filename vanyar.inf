      if(Dragon has animate) {
        if(self hasnt general) {
          give self general;
          "^Med ett vrål lyfter en svart drake från slottets balustrad och dyker emot dig.";
        }
        deadflag=1;
        "^Draken kastar sig över dig och du har inte en chans att skada honom från ditt underläge.
        Hans flammande andedräkt kremerar dig...";
      }
    ],
;

