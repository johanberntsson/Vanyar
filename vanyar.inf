Object -> Branch "branch"
    with
        name 'branch' 'torch',
        description [;
            if(self has light) "The branch is burning and makes an excellent
                torch.";
            "The branch is full of resin.";
        ],
        counter 0,
        daemon [;
            if(self has light) {
                self.counter = self.counter + 1;
                if(self.counter == 150) {
                    StopDaemon(self);
                    if(TestScope(self)) print "^The branch has burnt out.^";
                    remove self;
                }
            }
        ],
        before [;
        Extinguish:
            if(self hasnt light) "The branch isn't burning.";
            give self ~light;
            StopDaemon(self);
            "You put out the branch.";
        Burn:
            if(second == 0) {
                if(TestScope(Matches) == false) "You have no matches.";
                second = Matches;
            }
            if(second == Matches) {
                if(self has light) "The branch is already burning.";
                UseMatch();
                give self light;
                StartDaemon(self);
                "You light the branch with a match.";
            }
            "You will have to light it with a match.";
        ],
    ;

Object Mountain "mountain"
    with
        name 'mountain' 'mountains' 'range' 'cliff' 'rock' 'wall',
